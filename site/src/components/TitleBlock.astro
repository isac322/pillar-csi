---
import { REPO_URL, CHART_VERSION } from '../lib/site';
---

<footer class="title-block" aria-label="Site footer">
	<div>
		<span class="tb-label lettering">Project</span>
		<span class="tb-name">pillar-csi</span>
		<p>Kubernetes CSI driver for ZFS and LVM over NVMe-oF/TCP and iSCSI.</p>
	</div>
	<div>
		<span class="tb-label lettering">Sheets</span>
		<ul>
			<li><a href="/docs/">Documentation</a></li>
			<li><a href="/docs/tutorials/first-pvc/">Tutorial</a></li>
			<li><a href="/docs/community/faq/">FAQ</a></li>
		</ul>
	</div>
	<div>
		<span class="tb-label lettering">Source</span>
		<ul>
			<li><a href={REPO_URL}>GitHub</a></li>
			<li><a href={`${REPO_URL}/issues`}>Issues</a></li>
			<li><a href="/docs/community/contributing/">Contributing</a></li>
		</ul>
	</div>
	<div>
		<span class="tb-label lettering">Revision</span>
		<p>Chart {CHART_VERSION}</p>
		<p>Apache-2.0</p>
	</div>
</footer>

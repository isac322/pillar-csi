---
import type { landing } from '../../data/landing';

interface Props {
	steps: (typeof landing)['steps'];
}

const { steps } = Astro.props;
---

<section class="lp-section lp-steps" aria-labelledby="steps-title">
	<div class="lp-wrap">
		<h2 id="steps-title" class="lp-section__label">03 / Steps</h2>
		<ol class="lp-steps__list">
			{
				steps.map((step, i) => (
					<li class="lp-step">
						<div class="lp-step__text">
							<span class="lp-step__num" aria-hidden="true">
								{String(i + 1).padStart(2, '0')}
							</span>
							<h3 class="lp-step__title">{step.title}</h3>
							<p class="lp-step__body">{step.body}</p>
							{'moreHref' in step && step.moreHref && (
								<a class="lp-step__more" href={step.moreHref}>
									{('moreLabel' in step && step.moreLabel) || step.moreHref}
								</a>
							)}
						</div>
						<div class="lp-code">
							<div class="lp-code__bar">
								<span class="lp-code__lang">{step.lang}</span>
							</div>
							<pre><code class={`language-${step.lang}`}>{step.code}</code></pre>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

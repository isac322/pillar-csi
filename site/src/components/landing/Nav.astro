---
import StarButton from '../StarButton.astro';

interface Props {
	repo: string;
}

const { repo } = Astro.props;
---

<header class="lp-nav">
	<div class="lp-wrap lp-nav__inner">
		<a class="lp-brand" href="/" aria-label="pillar-csi home">
			<img src="/brand/mark.svg" alt="" width="28" height="28" />
			<span translate="no">pillar-csi</span>
		</a>
		<nav aria-label="Primary">
			<ul class="lp-nav__links">
				<li><a href="/docs/">Docs</a></li>
				<li><a href="/docs/tutorials/first-pvc/">Quickstart</a></li>
				<li class="lp-nav__star"><StarButton repo={repo} label="Star" /></li>
			</ul>
		</nav>
	</div>
</header>

---
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<section class="lp-section lp-limits" aria-labelledby="limits-title">
	<div class="lp-wrap">
		<h2 id="limits-title" class="lp-section__label"><span aria-hidden="true">05 / </span>Limits</h2>
		<p class="lp-limits__text">{text}</p>
	</div>
</section>

---
import type { landing } from '../../data/landing';

interface Props {
	comparison: (typeof landing)['comparison'];
}

const { comparison } = Astro.props;
const cellCount = Math.max(0, ...comparison.rows.map((row) => row.cells.length));
// columns may include a header for the row-label column; otherwise it is blank.
const hasLabelHeader = comparison.columns.length > cellCount;
const labelHeader = hasLabelHeader ? comparison.columns[0] : '';
const cellHeaders = hasLabelHeader ? comparison.columns.slice(1) : comparison.columns;
---

<section class="lp-section lp-compare" aria-labelledby="compare-title">
	<div class="lp-wrap">
		<h2 id="compare-title" class="lp-section__label">04 / Comparison</h2>
		<div class="lp-compare__scroll">
			<table class="lp-compare__table">
				<thead>
					<tr>
						<th scope="col">{labelHeader}</th>
						{cellHeaders.map((col) => <th scope="col">{col}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						comparison.rows.map((row) => (
							<tr>
								<th scope="row">{row.label}</th>
								{row.cells.map((cell) => (
									<td>{cell}</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<ul class="lp-compare__cards">
			{
				cellHeaders.map((col, i) => (
					<li class="lp-compare__card">
						<h3 class="lp-compare__card-title">{col}</h3>
						<dl>
							{comparison.rows.map((row) => (
								<div class="lp-compare__line">
									<dt>{row.label}</dt>
									<dd>{row.cells[i]}</dd>
								</div>
							))}
						</dl>
					</li>
				))
			}
		</ul>
		<p class="lp-compare__checked">
			Checked on <time datetime={comparison.checkedOn}>{comparison.checkedOn}</time>
		</p>
	</div>
</section>

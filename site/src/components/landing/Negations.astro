---
import type { landing } from '../../data/landing';

interface Props {
	items: (typeof landing)['negations'];
}

const { items } = Astro.props;
const blob = 'https://github.com/isac322/pillar-csi/blob/master/';

// evidence is "path[, path...]" optionally followed by ": note".
// A path may end in ":N" or ":N-M", which becomes a GitHub line anchor.
function parseEvidence(evidence: string) {
	const split = evidence.indexOf(': ');
	const pathPart = split === -1 ? evidence : evidence.slice(0, split);
	const note = split === -1 ? '' : evidence.slice(split + 2);
	const paths = pathPart.split(', ').map((token) => {
		const m = token.match(/^(.+?)(?::(\d+)(?:-(\d+))?)?$/);
		const file = m?.[1] ?? token;
		const anchor = m?.[2] ? `#L${m[2]}${m[3] ? `-L${m[3]}` : ''}` : '';
		return { text: token, href: `${blob}${file}${anchor}` };
	});
	return { paths, note };
}
---

<section class="lp-section lp-negations" aria-labelledby="negations-title">
	<div class="lp-wrap">
		<h2 id="negations-title" class="lp-section__label">01 / Facts</h2>
		<ul class="lp-negations__list">
			{
				items.map((item) => (
					<li class="lp-negation">
						<span class="lp-negation__value">{item.value}</span>
						<span class="lp-negation__label">{item.label}</span>
						<span class="lp-negation__evidence">
							{(() => {
								const { paths, note } = parseEvidence(item.evidence);
								return (
									<>
										{paths.map((p, i) => (
											<>
												{i > 0 && ', '}
												<a href={p.href}>{p.text}</a>
											</>
										))}
										{note && <span class="lp-negation__note">: {note}</span>}
									</>
								);
							})()}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

---
import type { landing } from '../../data/landing';
import StarButton from '../StarButton.astro';

interface Props {
	star: (typeof landing)['star'];
}

const { star } = Astro.props;
---

<aside class="lp-starbar" data-starbar aria-label="GitHub star">
	<div class="lp-wrap lp-starbar__inner">
		<p class="lp-starbar__text">{star.banner}</p>
		<div class="lp-starbar__actions">
			<StarButton repo={star.repo} label={star.button} variant="ink" />
			<button type="button" class="lp-starbar__close" data-starbar-close hidden aria-label="Hide for this visit">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
					<path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2"></path>
				</svg>
			</button>
		</div>
	</div>
</aside>

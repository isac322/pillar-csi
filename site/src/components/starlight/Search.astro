---
// Starlight hides the social icons on narrow screens, so the docs header shows
// a compact star button (icon and live count) next to search there instead.
import Default from '@astrojs/starlight/components/Search.astro';
import StarButton from '../StarButton.astro';
import { landing } from '../../data/landing';
---

<Default />
<span class="pc-star-mobile">
	<StarButton repo={landing.star.repo} label={landing.star.button} variant="compact" />
</span>

<style>
	.pc-star-mobile {
		display: inline-flex;
		align-items: center;
		margin-inline-start: 0.5rem;
	}
	@media (min-width: 50rem) {
		.pc-star-mobile {
			display: none;
		}
	}
</style>
